############################################################
# =================== HOST PORT SETTINGS ==================
############################################################
# These define which ports on your Windows machine expose
# the services running inside Docker containers.

# Direct CKAN internal port (usually NOT accessed directly in your setup)
CKAN_PORT_HOST=5000

# Nginx HTTP port (http://localhost:81)
NGINX_PORT_HOST=81

# Nginx HTTPS port (https://localhost:8443)
# This is the MAIN URL you use in your browser
NGINX_SSLPORT_HOST=8443


############################################################
# =================== POSTGRES DATABASE ===================
############################################################
# Main PostgreSQL database credentials

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=db   # "db" is the Docker service name

# CKAN main database user (used by CKAN app)
CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=ckandbpassword
CKAN_DB=ckandb

# Datastore (used for structured data like CSV preview & querying)
DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=datastore
DATASTORE_DB=datastore

# Database connection strings
CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:ckandbpassword@db/ckandb
CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:ckandbpassword@db/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore


############################################################
# ================= TEST DATABASE SETTINGS ================
############################################################
# Used for automated testing (can leave as-is)

TEST_CKAN_SQLALCHEMY_URL=postgres://ckan:ckan@db/ckan_test
TEST_CKAN_DATASTORE_WRITE_URL=postgresql://ckan:ckan@db/datastore_test
TEST_CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore_test


############################################################
# ================= DEVELOPMENT SETTINGS ===================
############################################################
# If true, CKAN assumes HTTPS internally
# Since you use Nginx with HTTPS on 8443, this is fine as false
USE_HTTPS_FOR_DEV=false


############################################################
# ================== CKAN CORE SETTINGS ===================
############################################################

CKAN_VERSION=2.10.0
CKAN_SITE_ID=default

# IMPORTANT:
# This must match how you access CKAN in the browser.
# Since you use https://localhost:8443, this must stay like this.
CKAN_SITE_URL=https://localhost:8443

# Session encryption secret (CHANGE in production!)
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME

# API token security keys (CHANGE in production!)
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:CHANGE_ME
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:CHANGE_ME

# Initial admin account created automatically
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=test1234
CKAN_SYSADMIN_EMAIL=your_email@example.com

# File upload storage path inside container
CKAN_STORAGE_PATH=/var/lib/ckan

# Email server configuration (needed for password reset)
# Not required for local dev unless you want email features working
CKAN_SMTP_SERVER=smtp.corporateict.domain:25
CKAN_SMTP_STARTTLS=True
CKAN_SMTP_USER=user
CKAN_SMTP_PASSWORD=pass
CKAN_SMTP_MAIL_FROM=ckan@localhost

# Maximum allowed upload size per file
CKAN_MAX_UPLOAD_SIZE_MB=100

# Server timezone
TZ=UTC


############################################################
# ======================= SOLR ============================
############################################################
# Solr is used for search indexing

SOLR_IMAGE_VERSION=2.10-solr9
CKAN_SOLR_URL=http://solr:8983/solr/ckan
TEST_CKAN_SOLR_URL=http://solr:8983/solr/ckan


############################################################
# ======================= REDIS ===========================
############################################################
# Redis is used for background jobs & caching

REDIS_VERSION=6
CKAN_REDIS_URL=redis://redis:6379/1
TEST_CKAN_REDIS_URL=redis://redis:6379/1


############################################################
# ===================== DATAPUSHER =========================
############################################################
# Datapusher enables automatic preview of uploaded CSV files

DATAPUSHER_VERSION=0.0.21
CKAN_DATAPUSHER_URL=http://datapusher:8800

# Callback URL (internal container communication)
CKAN__DATAPUSHER__CALLBACK_URL_BASE=http://ckan:5000


############################################################
# ======================== NGINX ==========================
############################################################
# Internal container ports (usually leave as default)

NGINX_PORT=80
NGINX_SSLPORT=443


############################################################
# ======================= EXTENSIONS =======================
############################################################
# Core CKAN plugins enabled
# DO NOT remove "envvars" (it loads .env variables)
CKAN__PLUGINS="image_view text_view datatables_view datastore datapusher envvars"

# Harvest extension message queue (if using harvesting)
CKAN__HARVEST__MQ__TYPE=redis
CKAN__HARVEST__MQ__HOSTNAME=redis
CKAN__HARVEST__MQ__PORT=6379
CKAN__HARVEST__MQ__REDIS_DB=1


############################################################
# ======================= CORS =============================
############################################################
# Allows React (localhost:3000) to access CKAN API
# Good for development only
CKAN__CORS__ORIGIN_ALLOW_ALL=true


############################################################
# =================== USER MANAGEMENT =====================
############################################################

# Allow users to register accounts via web UI
CKAN__AUTH__CREATE_USER_VIA_WEB=true

# Hide user details from anonymous public users
# (recommended for privacy in school portals)
CKAN__AUTH__PUBLIC_USER_DETAILS=false

# Enable file uploads (for datasets, images, etc.)
CKAN__UPLOADS_ENABLED=true